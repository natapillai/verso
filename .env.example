# Copy nothing from here. Run `vercel env pull .env.local` to fetch real values.
# Do that at the start of every work session: the OIDC token below expires, and
# an expired one shows up as uploads failing on auth while everything else works.

# Postgres on Neon, pooled. Used by the app.
DATABASE_URL=

# Postgres on Neon, direct. Used by drizzle-kit for migrations, which run one at
# a time and do not want a pooler in the way.
DATABASE_URL_UNPOOLED=

# The Blob store id. The SDK pairs this with VERCEL_OIDC_TOKEN to authenticate,
# so there is no long lived blob token to manage.
BLOB_STORE_ID=

# Short lived OIDC token. Vercel populates and rotates it on every deployment.
VERCEL_OIDC_TOKEN=

# Verifies webhook callbacks from Vercel Blob. Unused here: uploads go through
# the server, not through presigned browser uploads.
BLOB_WEBHOOK_PUBLIC_KEY=

# Anthropic Messages API, used from slice 02. Separate keys for preview and
# production so a preview cannot spend the production budget. Never exported to
# your shell. Unset it to exercise the fallback extractor.
ANTHROPIC_API_KEY=
